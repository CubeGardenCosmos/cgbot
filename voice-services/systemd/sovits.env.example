# 复制为 <env-dir>/sovits.env 并按需修改。
CGBOT_VOICE_DATA_DIR=<data-dir>
# 角色模型目录,须含 sovits.pth、gpt.ckpt、ref.wav(见 ../MODELS.md)
CGBOT_SOVITS_MODEL_DIR=<model-dir>
# 参考音频 ref.wav 的逐字文本(必须与音频内容一致)与语言
CGBOT_SOVITS_REF_PROMPT_TEXT=
CGBOT_SOVITS_REF_PROMPT_LANG=zh
CGBOT_SOVITS_CHARACTER=default
CGBOT_SOVITS_HOST=127.0.0.1
CGBOT_SOVITS_PORT=10096
#CGBOT_SOVITS_SOCKET=<data-dir>/sovits.sock
#CGBOT_VOICE_CONTAINER_PREFIX=/data
