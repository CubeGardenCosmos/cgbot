+double active_rms_dbfs(const MixInput& stem, const ChannelPlan& plan) {
+  double sum = 0.0;
+  std::size_t frames = 0;
+  for (const abi::ms_NoteEvent_5& note : plan.notes) {
+    const auto begin = static_cast<std::size_t>(std::max<long long>(0, note._location_us) * kSampleRate / 1'000'000);
+    const auto end = std::min(stem.left.size(),
+                              begin + static_cast<std::size_t>(note._duration_us * kSampleRate / 1'000'000));
+    for (std::size_t i = begin; i < end; ++i) {
+      sum += static_cast<double>(stem.left[i]) * stem.left[i] + static_cast<double>(stem.right[i]) * stem.right[i];
+    }
+    if (end > begin) frames += end - begin;
+  }
+  if (frames == 0 || sum <= 0.0) return -120.0;
+  return 10.0 * std::log10(sum / (2.0 * static_cast<double>(frames)));
