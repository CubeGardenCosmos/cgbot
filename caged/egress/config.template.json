{
  "mixed-port": 7890,
  "allow-lan": true,
  "bind-address": "*",
  "mode": "rule",
  "log-level": "warning",
  "ipv6": false,
  "sniffer": {"enable": false},
  "geo-auto-update": false,
  "geodata-mode": false,
  "dns": {
    "enable": true,
    "ipv6": false,
    "enhanced-mode": "redir-host",
    "nameserver": ["223.5.5.5", "1.1.1.1"]
  },
  "proxies": [{
    "name": "host-mihomo",
    "type": "http",
    "server": "host.docker.internal",
    "port": "__HOST_PROXY_PORT__",
    "username": "__HOST_PROXY_USER__",
    "password": "__HOST_PROXY_PASS__"
  }],
  "rules": []
}
