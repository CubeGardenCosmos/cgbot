#!/usr/bin/python3
"""Render UTF-8 Markdown with the image's system Python and CJK fonts."""

import argparse
import html
from pathlib import Path

import markdown
from weasyprint import CSS, HTML


STYLES = """
@page { size: A4; margin: 18mm 16mm;
  @bottom-center { content: counter(page); font-size: 9pt; color: #666; }
}
html { font-family: "Noto Sans CJK SC", "Noto Sans CJK TC", "Noto Sans CJK JP", sans-serif;
       font-size: 10pt; line-height: 1.6; overflow-wrap: anywhere; }
body { margin: 0; }
h1, h2, h3, h4, h5, h6 { line-height: 1.35; break-after: avoid; }
h1 { font-size: 22pt; } h2 { font-size: 17pt; } h3 { font-size: 13pt; }
p, li { orphans: 3; widows: 3; }
a { color: #1556a0; text-decoration: none; }
pre, code { font-family: "DejaVu Sans Mono", "Noto Sans CJK SC", monospace; font-size: 9pt; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: 3mm;
      background: #f3f4f6; border: 0.2mm solid #ddd; }
code { white-space: pre-wrap; }
table { border-collapse: collapse; width: 100%; table-layout: fixed; margin: 4mm 0; }
thead { display: table-header-group; }
tr { break-inside: avoid; }
th, td { border: 0.2mm solid #bbb; padding: 2mm; vertical-align: top; }
th { background: #edf0f3; }
blockquote { margin-left: 0; padding-left: 4mm; border-left: 1mm solid #ccc; color: #444; }
img { max-width: 100%; height: auto; }
"""


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", type=Path, help="UTF-8 Markdown source")
    parser.add_argument("output", type=Path, help="destination PDF")
    args = parser.parse_args()
    source = args.input.resolve(strict=True)
    destination = args.output.resolve()
    if source == destination:
        parser.error("input and output must be different files")
    body = markdown.markdown(
        source.read_text(encoding="utf-8"), extensions=["tables", "fenced_code", "sane_lists"]
    )
    document = (
        '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8">'
        f"<title>{html.escape(source.stem)}</title></head><body>{body}</body></html>"
    )
    destination.parent.mkdir(parents=True, exist_ok=True)
    HTML(string=document, base_url=source.parent.as_uri() + "/").write_pdf(
        str(destination), stylesheets=[CSS(string=STYLES)]
    )
    print(destination)


if __name__ == "__main__":
    main()
