+int cmd_calibrate(int argc, char** argv) {
+  muse::CalibrateOptions options;
+  std::optional<std::string> out_cpp;
+  for (int i = 2; i < argc; ++i) {
+    const std::string arg = argv[i];
+    const auto value = [&]() -> std::string {
+      if (i + 1 >= argc) throw Error("bad_input", "Missing value for " + arg);
+      return argv[++i];
+    };
+    if (arg == "--engine") {
+      const std::string eng = value();
+      if (eng != "muse") throw Error("bad_input", "calibrate only supports --engine muse");
+    } else if (arg == "--samples-dir") {
+      options.samples_dir = value();
+    } else if (arg == "--soundfont-dir") {
+      options.soundfont_dir = value();
+    } else if (arg == "--out-cpp") {
+      out_cpp = value();
+    } else if (arg == "--json") {
+      // default format is json
+    } else {
+      throw Error("bad_input", "Unknown option for calibrate: " + arg);
+    }
+  }
+  const auto results = muse::run_calibration(options);
+  if (out_cpp) {
+    const std::string code = muse::generate_levels_cpp(results);
+    std::ofstream out(*out_cpp);
+    if (!out) throw Error("bad_input", "Cannot write to " + *out_cpp);
+    out << code;
+    std::cout << "{\"written\":" << json_string(*out_cpp)
+              << ",\"count\":" << results.size() << "}\n";
+    return 0;
+  }
+  std::cout << muse::format_calibration_json(results);
+  return 0;
+}
