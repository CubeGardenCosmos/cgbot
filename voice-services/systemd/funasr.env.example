# 复制为 <env-dir>/funasr.env 并按需修改(systemd EnvironmentFile,不要加引号以外的 shell 语法)。
CGBOT_VOICE_DATA_DIR=<data-dir>
# 留空 = 在线下载 iic/SenseVoiceSmall;填本地快照目录则优先使用(目录存在时)
CGBOT_ASR_MODEL_PATH=
CGBOT_ASR_HOST=127.0.0.1
CGBOT_ASR_PORT=10095
#CGBOT_ASR_SOCKET=<data-dir>/funasr.sock
#CGBOT_VOICE_CONTAINER_PREFIX=/data
