#!/usr/bin/env python3
"""cgbot sandbox entrypoint.

Runs on every container start as the image's agent user (uid 1000). It renders the Codex
config from the CGBOT_* contract, links image-owned skills and global instructions into
$CODEX_HOME, stores the app-server capability token in a 0600 file, then execs
`codex app-server` as the resident process. Standard library only. Tokens and message
bodies are never printed.
"""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit

IMAGE_ROOT = Path("/opt/cgbot")
BRIDGE_SCRIPT = IMAGE_ROOT / "bridge" / "cgbot_bridge_mcp.py"
REPORT_SCRIPT = IMAGE_ROOT / "bridge" / "cgbot_report_mcp.py"
SKILLS_SRC = IMAGE_ROOT / "skills"
AGENTS_SRC = IMAGE_ROOT / "codex" / "AGENTS.md"
LSP_CONFIG = IMAGE_ROOT / "lsp" / "cclsp.json"
MODEL_CATALOG_TEMPLATE = IMAGE_ROOT / "codex" / "model_catalog_template.json"
DEFAULT_CONTEXT_WINDOW = 128000
CHROMIUM = "/usr/bin/chromium"

USER_ID_RE = re.compile(r"^[A-Za-z0-9_.-]{1,128}$")
MODEL_RE = re.compile(r"^[A-Za-z0-9._:/-]{1,128}$")
EFFORTS = ("minimal", "low", "medium", "high")
REQUIRED = (
    "CGBOT_USER_ID",
    "CGBOT_GATEWAY_URL",
    "CGBOT_GATEWAY_TOKEN",
    "CGBOT_BRIDGE_URL",
    "CGBOT_BRIDGE_TOKEN",
    "CGBOT_WS_TOKEN",
    "CGBOT_APPSERVER_PORT",
    "CGBOT_MODEL",
    "CGBOT_REASONING_EFFORT",
)


def fail(message: str) -> None:
    print(f"cgbot-sandbox-entrypoint: {message}", file=sys.stderr)
    sys.exit(2)


def require_env() -> dict[str, str]:
    values: dict[str, str] = {}
    for name in REQUIRED:
        value = os.environ.get(name, "")
        if not value:
            fail(f"missing required environment variable {name}")
        values[name] = value
    return values


def check_url(name: str, value: str) -> str:
    parts = urlsplit(value)
    if parts.scheme not in ("http", "https") or not parts.netloc or any(c.isspace() for c in value):
        fail(f"{name} must be an http(s) URL without whitespace")
    return value


def check_token(name: str, value: str) -> str:
    if any(c.isspace() or not c.isprintable() for c in value):
        fail(f"{name} contains whitespace or non-printable characters")
    return value


def toml_str(value: str) -> str:
    # JSON string escapes are valid TOML basic-string escapes for the validated inputs.
    return json.dumps(value, ensure_ascii=True)


def check_model(value: str) -> None:
    if not MODEL_RE.match(value):
        fail("CGBOT_MODEL has unsupported characters")


def check_effort(value: str) -> None:
    if value not in EFFORTS:
        fail(f"CGBOT_REASONING_EFFORT must be one of {', '.join(EFFORTS)}")


def context_window() -> int:
    raw = os.environ.get("CGBOT_CONTEXT_WINDOW", "")
    if not raw:
        return DEFAULT_CONTEXT_WINDOW
    if not raw.isdigit() or not 1024 <= int(raw) <= 10_000_000:
        fail("CGBOT_CONTEXT_WINDOW must be an integer between 1024 and 10000000")
    return int(raw)


def write_model_catalog(codex_home: Path, model: str, window: int) -> Path:
    catalog = json.loads(MODEL_CATALOG_TEMPLATE.read_text(encoding="utf-8"))
    entry = catalog["models"][0]
    entry.update(slug=model, display_name=model, context_window=window, max_context_window=window)
    path = codex_home / "model_catalog.json"
    write_private(path, json.dumps(catalog, ensure_ascii=False, indent=2) + "\n")
    return path


def render_config(values: dict[str, str], home: Path, catalog_path: Path) -> str:
    gateway_url = check_url("CGBOT_GATEWAY_URL", values["CGBOT_GATEWAY_URL"])
    model = values["CGBOT_MODEL"]
    effort = values["CGBOT_REASONING_EFFORT"]

    playwright_args = [
        "--headless",
        "--browser",
        "chromium",
        "--executable-path",
        CHROMIUM,
        "--no-sandbox",
        "--user-data-dir",
        str(home / ".browser-profile"),
    ]
    proxy = os.environ.get("HTTPS_PROXY") or os.environ.get("HTTP_PROXY")
    if proxy:
        playwright_args += ["--proxy-server", check_url("HTTPS_PROXY", proxy)]

    lines = [
        "# Generated by cgbot-sandbox-entrypoint on every start. Edits are overwritten.",
        f"model_provider = {toml_str('cgbot')}",
        f"model = {toml_str(model)}",
        f"model_reasoning_effort = {toml_str(effort)}",
        f"model_catalog_json = {toml_str(str(catalog_path))}",
        'approval_policy = "never"',
        'sandbox_mode = "danger-full-access"',
        "",
        "[model_providers.cgbot]",
        'name = "cgbot"',
        f"base_url = {toml_str(gateway_url)}",
        'env_key = "CGBOT_GATEWAY_TOKEN"',
        'wire_api = "responses"',
        "",
        '[projects."/workspace"]',
        'trust_level = "trusted"',
        "",
        "[mcp_servers.bridge]",
        'command = "python3"',
        f"args = [{toml_str(str(BRIDGE_SCRIPT))}]",
        'env_vars = ["CGBOT_BRIDGE_URL", "CGBOT_BRIDGE_TOKEN", "CGBOT_USER_ID"]',
        "",
        "[mcp_servers.report]",
        'command = "python3"',
        f"args = [{toml_str(str(REPORT_SCRIPT))}]",
        'env_vars = ["HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy"]',
        "tool_timeout_sec = 240",
        "",
        "[mcp_servers.playwright]",
        'command = "playwright-mcp"',
        "args = [" + ", ".join(toml_str(a) for a in playwright_args) + "]",
        "",
        "[mcp_servers.lsp]",
        'command = "cclsp"',
        f"env = {{ CCLSP_CONFIG_PATH = {toml_str(str(LSP_CONFIG))} }}",
        "",
    ]
    return "\n".join(lines)


def write_private(path: Path, text: str) -> None:
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp, path)


def link_skills(codex_home: Path) -> list[str]:
    target_dir = codex_home / "skills"
    target_dir.mkdir(mode=0o700, exist_ok=True)
    wanted = {p.name: p for p in sorted(SKILLS_SRC.iterdir()) if (p / "SKILL.md").is_file()}
    for entry in target_dir.iterdir():
        if entry.is_symlink() and str(os.readlink(entry)).startswith(str(SKILLS_SRC)):
            if entry.name not in wanted:
                entry.unlink()
    for name, src in wanted.items():
        link = target_dir / name
        if link.is_symlink():
            if os.readlink(link) == str(src):
                continue
            link.unlink()
        elif link.exists():
            fail(f"refusing to replace non-symlink skill entry {name}")
        link.symlink_to(src, target_is_directory=True)
    return sorted(wanted)


def link_agents(codex_home: Path) -> None:
    link = codex_home / "AGENTS.md"
    if link.is_symlink() and os.readlink(link) == str(AGENTS_SRC):
        return
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(AGENTS_SRC)


def main() -> None:
    values = require_env()
    if not USER_ID_RE.match(values["CGBOT_USER_ID"]):
        fail("CGBOT_USER_ID has unsupported characters")
    check_url("CGBOT_BRIDGE_URL", values["CGBOT_BRIDGE_URL"])
    check_token("CGBOT_GATEWAY_TOKEN", values["CGBOT_GATEWAY_TOKEN"])
    check_token("CGBOT_BRIDGE_TOKEN", values["CGBOT_BRIDGE_TOKEN"])
    ws_token = check_token("CGBOT_WS_TOKEN", values["CGBOT_WS_TOKEN"])
    port_text = values["CGBOT_APPSERVER_PORT"]
    if not port_text.isdigit() or not 1 <= int(port_text) <= 65535:
        fail("CGBOT_APPSERVER_PORT must be 1-65535")
    check_model(values["CGBOT_MODEL"])
    check_effort(values["CGBOT_REASONING_EFFORT"])
    for required_path in (
        BRIDGE_SCRIPT,
        REPORT_SCRIPT,
        AGENTS_SRC,
        LSP_CONFIG,
        SKILLS_SRC,
        MODEL_CATALOG_TEMPLATE,
    ):
        if not required_path.exists():
            fail(f"image is missing {required_path}")

    home = Path(os.environ.get("HOME", "/home/agent"))
    codex_home = Path(os.environ.get("CODEX_HOME", str(home / ".codex")))
    codex_home.mkdir(mode=0o700, parents=True, exist_ok=True)
    (home / ".browser-profile").mkdir(mode=0o700, exist_ok=True)
    run_dir = home / ".cgbot"
    run_dir.mkdir(mode=0o700, exist_ok=True)

    catalog_path = write_model_catalog(codex_home, values["CGBOT_MODEL"], context_window())
    write_private(codex_home / "config.toml", render_config(values, home, catalog_path))
    link_agents(codex_home)
    skills = link_skills(codex_home)

    token_path = run_dir / "appserver.token"
    write_private(token_path, ws_token + "\n")

    os.environ.pop("CGBOT_WS_TOKEN", None)
    os.environ["CODEX_HOME"] = str(codex_home)
    print(
        f"cgbot-sandbox: starting app-server on port {port_text}; skills={','.join(skills) or '-'}",
        file=sys.stderr,
    )
    os.execvp(
        "codex",
        [
            "codex",
            "--strict-config",
            "app-server",
            "--listen",
            f"ws://0.0.0.0:{port_text}",
            "--ws-auth",
            "capability-token",
            "--ws-token-file",
            str(token_path),
        ],
    )


if __name__ == "__main__":
    main()
