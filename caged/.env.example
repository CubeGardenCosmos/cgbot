# Environment variables for the caged stack (example values only)
# Copy to .env and fill with actual values

# Host mihomo proxy authentication
HOST_PROXY_PORT=7895
HOST_PROXY_USER=cageduser
HOST_PROXY_PASS=

# Host mihomo proxy group target (required)
# The proxy group in the host mihomo config that egress traffic should use
HOST_PROXY_GROUP=

# Network configuration
EGRESS_SUBNET=172.30.2.0/24
EGRESS_IP=172.30.2.2

# Geosite database location on host
GEOSITE_FILE=/etc/mihomo/geosite.dat

# Privileged source CIDR (optional, default 172.30.1.128/25)
# PRIVILEGED_CIDR=172.30.1.128/25

# Optional LAN access configuration
# LAN_CIDR: CIDR range for DIRECT access (e.g., "192.168.0.0/16")
# PROTECTED_HOSTS: comma-separated list of host:port pairs that should be
#                  rejected except on the specified port
#                  Format: "192.168.1.10:22,192.168.1.20:2022"
# LAN_CIDR=
# PROTECTED_HOSTS=
