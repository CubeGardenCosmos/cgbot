# systemd 用户单元示例:omp 搜索 relay(宿主机 192.168.1.19)。
# 安装步骤见 deploy/README.md 的 "omp 搜索 relay" 一节。本文件不会被自动安装。
#
# 路径假设:仓库位于 %h/cgbot,omp 位于 %h/.local/bin/omp,令牌位于
# %h/.config/omp-search-relay/token(0600)。%h 为该用户家目录。

[Unit]
Description=omp search relay (Gemini grounding search for cgbot)
Documentation=file://%h/cgbot/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/cgbot/deploy/omp-search-relay.py \
    --bind 172.17.0.1 \
    --port 8791 \
    --token-file %h/.config/omp-search-relay/token \
    --omp %h/.local/bin/omp \
    --model gemini-2.5-flash \
    --timeout 75 \
    --max-concurrency 2
# 退出码非 0 或被杀才重启;显式 systemctl stop 不重启。
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=100
KillMode=control-group
# omp 需要 node 与 bun 的 PATH;不要把令牌放进 Environment。
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin

# 资源限制
MemoryMax=512M
TasksMax=64
CPUQuota=50%

# 进程隔离(不影响 omp 读写其配置目录)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
